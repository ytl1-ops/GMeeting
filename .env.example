# --- Analyse (rédaction PV / CR / note de synthèse) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Transcription ---
# auto = faster-whisper local s'il est installé, sinon API OpenAI
# local | openai | auto
TRANSCRIBE_PROVIDER=auto
OPENAI_API_KEY=
# WHISPER_MODEL=small          # tiny/base/small/medium/large-v3 (local)

# --- Sécurité / confidentialité ---
# Si défini, l'application demande ce mot de passe (HTTP Basic, utilisateur: "gmeeting")
GMEETING_PASSWORD=
# true pour conserver les fichiers audio après transcription (défaut: supprimés)
KEEP_AUDIO=false
# DATA_DIR=./data
