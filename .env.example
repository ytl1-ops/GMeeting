# --- Analyse (rédaction PV / CR / note de synthèse) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Transcription ---
# auto = faster-whisper local s'il est installé, sinon API OpenAI
# local | openai | auto
TRANSCRIBE_PROVIDER=auto
OPENAI_API_KEY=
# WHISPER_MODEL=small          # tiny/base/small/medium/large-v3 (local)

# --- Sécurité / confidentialité ---
# Si défini, l'application demande ce mot de passe (HTTP Basic, utilisateur: "gmeeting")
GMEETING_PASSWORD=
# true pour conserver les fichiers audio après transcription (défaut: supprimés)
KEEP_AUDIO=false
# Supprime automatiquement les réunions terminées de plus de N jours (audio, archive, pièces jointes compris) ; 0 = jamais
# RETENTION_DAYS=0
# (Docker) nom de domaine pour le certificat HTTPS automatique
# DOMAIN=localhost

# --- Pièces jointes ---
# MAX_ATTACH_MB=25                 # taille maximale par fichier
# MAX_ATTACH_PER_MEETING=20
# ATTACH_CONTEXT_CHARS=120000      # texte des pièces jointes transmis à l'IA pour la rédaction

# --- Audio ---
# AUDIO_KBPS=32          # débit Opus du fichier de travail/archive (12-128) : 32 ≈ 12-14 Mo/h
# AUDIO_ENHANCE=true     # passe-haut + normalisation du volume
# DATA_DIR=./data
